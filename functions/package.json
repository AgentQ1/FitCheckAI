{
  "name": "fitcheckai-functions",
  "version": "1.0.0",
  "description": "FitCheck AI Firebase Cloud Functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "node test-upload.js",
    "test:emulator": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@apple/app-store-server-library": "^1.6.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.0.0",
    "openai": "^4.0.0",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
