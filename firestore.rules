rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // New user creation — allow all fields including default subscription values
      allow create: if request.auth != null && request.auth.uid == uid;

      // Updates: block client writes to premium/payment fields — only backend webhook can touch these
      allow update: if request.auth != null && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'isPremium',
                'subscriptionStatus',
                'stripeCustomerId',
                'stripeSubscriptionId',
                'currentPeriodEnd',
                'planName',
                'fitCheckLimit',
                'subscriptionTier'
              ]);

      match /fit_checks/{fitCheckId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /ratings/{ratingId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }

        match /generated_looks/{lookId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }

        // AI upgrade history tied to a specific analysis (Firestore rules don't
        // cascade, so this needs its own match).
        match /generatedUpgrades/{upgradeId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /saved_looks/{lookId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Durable, user-saved upgrades — never pruned by cleanup.
      match /savedUpgrades/{upgradeId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /generation_jobs/{jobId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Payment records: users can read their own, backend writes only
      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Public profile mirror: a minimal, world-readable (to any signed-in user)
    // copy of displayName/photoURL/profileImageUpdatedAt. Leaderboards read these
    // to show fresh names/avatars for users whose full users/{uid} doc they
    // aren't allowed to read. Each user may write only their own.
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Weekly trends: any authenticated user can read; only Cloud Functions write
    match /weekly_trends/{weekId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Weekly leaderboard: ranked public user standings, aggregated by backend.
    // Any authenticated user can read; only Cloud Functions write.
    match /weeklyTrends/{weekId}/users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Daily "Today's Best" leaderboard: highest single outfit score per user
    // for the local day, aggregated by backend. Read-only for clients.
    match /dailyTrends/{dayId}/users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
