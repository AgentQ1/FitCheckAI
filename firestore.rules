rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only access their own user document and all subcollections
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /fit_checks/{fitCheckId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /ratings/{ratingId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }

        match /generated_looks/{lookId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /saved_looks/{lookId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /generation_jobs/{jobId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Weekly trends: any authenticated user can read; only Cloud Functions write
    match /weekly_trends/{weekId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
