# App Store Connect API — copy to .env.asc.local (git-ignored) and fill in.
# The .p8 private key itself is NEVER committed (see .gitignore: private_keys/, *.p8).

# App Store Connect API Key ID (e.g. 3TH447PNUA)
ASC_KEY_ID=

# App Store Connect Issuer ID (UUID from Users and Access > Integrations > App Store Connect API)
ASC_ISSUER_ID=

# Path to the downloaded .p8 private key. Keep it inside private_keys/ (git-ignored).
ASC_KEY_PATH=private_keys/AuthKey_3TH447PNUA.p8

# FitCheck app reference (read-only convenience; not secret)
ASC_APP_ID=6782241321
ASC_BUNDLE_ID=ai.fitcheck.app
